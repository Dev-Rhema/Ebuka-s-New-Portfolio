{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ebukaaa.vercel.app" }],
      "destination": "https://ebuka.marketing/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/case-study/:id", "destination": "/case-study.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
